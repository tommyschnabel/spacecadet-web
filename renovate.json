{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track upstream SpaceCadetPinball commits pinned in the Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "ARG SCP_REPO=(?<depName>\\S+?)(\\.git)?\\nARG SCP_COMMIT=(?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "master"
    }
  ]
}
