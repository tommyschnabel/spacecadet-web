+
+// Browser port: bar along the bottom listing the current flipper/plunger keys,
+// in the same font and height as the menu bar. The table is scaled to fit above it.
+void winmain::RenderControlsFooter()
+{
+	const auto height = static_cast<int>(ImGui::GetFrameHeight());
+	if (FooterHeight != height)
+	{
+		FooterHeight = height;
+		fullscrn::window_size_changed();
+	}
+
+	std::string text;
+	for (auto binding : {GameBindings::LeftFlipper, GameBindings::RightFlipper, GameBindings::Plunger})
+	{
+		const auto& keyDef = Options.Key[~binding];
+		auto key = keyDef.GetShortcutDescription();
+		if (key.empty())
+			continue;
+		if (!text.empty())
+			text += "      ";
+		text += std::string(pb::get_rc_string(keyDef.Description)) + ": " + key;
+	}
+
+	const auto viewport = ImGui::GetMainViewport();
+	ImGui::SetNextWindowPos({viewport->Pos.x, viewport->Pos.y + viewport->Size.y - height});
+	ImGui::SetNextWindowSize({viewport->Size.x, static_cast<float>(height)});
+	ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 0);
+	ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 0);
+	ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImGui::GetStyle().FramePadding);
+	ImGui::PushStyleColor(ImGuiCol_WindowBg, ImGui::GetStyleColorVec4(ImGuiCol_MenuBarBg));
+	if (ImGui::Begin("##ControlsFooter", nullptr,
+	                 ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoMove |
+	                 ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoFocusOnAppearing |
+	                 ImGuiWindowFlags_NoBringToFrontOnFocus | ImGuiWindowFlags_NoNav))
+	{
+		const auto textWidth = ImGui::CalcTextSize(text.c_str()).x;
+		ImGui::SetCursorPosX(std::max(ImGui::GetStyle().FramePadding.x, (viewport->Size.x - textWidth) / 2));
+		ImGui::TextUnformatted(text.c_str());
+	}
+	ImGui::End();
+	ImGui::PopStyleColor();
+	ImGui::PopStyleVar(3);
 }
 
 void winmain::ImGuiMenuItemWShortcut(GameBindings binding, bool selected)
