diff -ruN scp-a/CMakeLists.txt scp-b/CMakeLists.txt
--- scp-a/CMakeLists.txt	2026-11-16 10:18:36
+++ scp-b/CMakeLists.txt	2026-11-16 10:18:59
@@ -32,8 +32,16 @@
 # SDL2main is not needed
 set(SDL2_BUILDING_LIBRARY ON)
 
+if(EMSCRIPTEN)
+    # Browser build: SDL2 + SDL2_mixer come from Emscripten ports.
+    set(EM_PORT_FLAGS "-sUSE_SDL=2 -sUSE_SDL_MIXER=2")
+    set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${EM_PORT_FLAGS}")
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${EM_PORT_FLAGS}")
+    set(CMAKE_EXECUTABLE_SUFFIX ".js")
+else()
 find_package(SDL2 REQUIRED)
 FIND_PACKAGE(SDL2_mixer REQUIRED)
+endif()
 
 include_directories(${SDL2_INCLUDE_DIR} ${SDL2_MIXER_INCLUDE_DIR})
 get_property(dirs DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR} PROPERTY INCLUDE_DIRECTORIES)
@@ -217,6 +225,19 @@
 endif()
 
 target_link_libraries(SpaceCadetPinball ${SDL2_LIBRARY} ${SDL2_MIXER_LIBRARY})
+
+if(EMSCRIPTEN)
+    target_link_options(SpaceCadetPinball PRIVATE
+        -sUSE_SDL=2 -sUSE_SDL_MIXER=2
+        -sASYNCIFY -sASYNCIFY_STACK_SIZE=65536
+        -sALLOW_MEMORY_GROWTH=1
+        -sINITIAL_MEMORY=134217728
+        -sFORCE_FILESYSTEM=1
+        -sEXPORTED_RUNTIME_METHODS=FS,IDBFS,addRunDependency,removeRunDependency
+        -sENVIRONMENT=web
+        -lidbfs.js
+    )
+endif()
 
 # On Windows, copy DLL to output
 if(WIN32)
