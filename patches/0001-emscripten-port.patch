--- scp-a/SpaceCadetPinball/midi.cpp	2026-11-16 10:18:36
+++ scp-b/SpaceCadetPinball/midi.cpp	2026-11-16 10:31:36
@@ -120,7 +120,22 @@
 		fileName.insert(0, "SOUND");
 	}
 
-	auto audio = load_track_sub(fileName, true);
+	Mix_Music* audio = nullptr;
+#ifdef __EMSCRIPTEN__
+	// Browser port: the server pre-renders MIDI tracks to Ogg Vorbis
+	// (no MIDI synth in the browser build of SDL_mixer).
+	{
+		auto oggPath = pb::make_path_name(fileName + ".OGG");
+		auto fileHandle = fopenu(oggPath.c_str(), "rb");
+		if (fileHandle)
+		{
+			fclose(fileHandle);
+			audio = Mix_LoadMUS(oggPath.c_str());
+		}
+	}
+	if (!audio)
+#endif
+	audio = load_track_sub(fileName, true);
 	if (!audio)
 		audio = load_track_sub(fileName, false);
 
